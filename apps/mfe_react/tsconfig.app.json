{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": ["node"]
  },
  "files": [
    "src/main.ts",
    "typings/global.d.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "typings/**/*.d.ts",
    "../../libs/web-components/src/**/*.ts"
  ],
  "exclude": [
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "../../libs/web-components/src/**/*.tsx",
    "../../libs/web-components/src/**/*.stories.ts",
    "../../libs/web-components/src/**/*.stories.tsx",
    "../../libs/web-components/src/lib/chart/**/*"
  ]
}
